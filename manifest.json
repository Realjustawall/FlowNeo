{
  "manifest_version": 3,
  "name": "FlowNeo",
  "version": "1.4.0",
  "minimum_chrome_version": "111",
  "description": "Local Google Flow client configuration helper with persistent controls and bounded diagnostics.",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://flow.google.com/*"
  ],
  "background": {
    "service_worker": "app.js"
  },
  "action": {
    "default_title": "FlowNeo",
    "default_popup": "panel.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "stat.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "author": "RealJustAWall"
}
