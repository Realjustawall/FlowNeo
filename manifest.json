{
  "manifest_version": 3,
  "name": "FlowNeo",
  "version": "1.3.0",
  "minimum_chrome_version": "111",
  "description": "A modern control panel for enabling the FlowNeo helper on Google Flow and reloading active Flow tabs.",
  "permissions": ["scripting"],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://flow.cfcnode.com/*"
  ],
  "background": {"service_worker": "app.js"},
  "action": {
    "default_title": "FlowNeo",
    "default_popup": "panel.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {"matches": ["https://flow.google.com/*"], "js": ["link.js"], "run_at": "document_start"},
    {"matches": ["https://flow.google.com/*"], "js": ["stat.js"], "run_at": "document_idle"}
  ],
  "author": "RealJustAWall"
}
